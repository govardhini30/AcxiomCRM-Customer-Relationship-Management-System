@model Opportunity
@{ ViewData["Title"] = "Edit Opportunity"; }<h2>Edit Opportunity</h2><form asp-action="Edit" method="post"><input asp-for="OpportunityId" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><input asp-for="OpportunityName" class="form-control mb-2"/><input asp-for="Amount" class="form-control mb-2"/><input asp-for="Probability" class="form-control mb-2"/><input asp-for="ExpectedCloseDate" class="form-control mb-2"/><select asp-for="Stage" class="form-select mb-2"><option>Qualification</option><option>Proposal</option><option>Negotiation</option><option>Won</option><option>Lost</option></select><select asp-for="Status" class="form-select mb-2"><option>Open</option><option>Won</option><option>Lost</option></select><textarea asp-for="Notes" class="form-control mb-2"></textarea><button class="btn btn-success">Save</button></form>
