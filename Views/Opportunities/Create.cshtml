@model Opportunity
@{ ViewData["Title"] = "Create Opportunity"; }<h2>Create Opportunity</h2><form asp-action="Create" method="post"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="OpportunityName" class="form-control mb-2" placeholder="Opportunity name"/><input asp-for="Amount" class="form-control mb-2" placeholder="Amount"/><input asp-for="Probability" class="form-control mb-2" placeholder="Probability"/><input asp-for="ExpectedCloseDate" class="form-control mb-2"/><select asp-for="Stage" class="form-select mb-2"><option>Qualification</option><option>Proposal</option><option>Negotiation</option><option>Won</option><option>Lost</option></select><select asp-for="Status" class="form-select mb-2"><option>Open</option><option>Won</option><option>Lost</option></select><textarea asp-for="Notes" class="form-control mb-2" placeholder="Notes"></textarea><button class="btn btn-success">Save</button></form>
