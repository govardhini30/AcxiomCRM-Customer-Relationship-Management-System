@model IEnumerable<Opportunity>
@{ ViewData["Title"] = "Opportunities"; }<div class="d-flex justify-content-between"><h2>Opportunities</h2><a class="btn btn-primary" asp-action="Create">Create</a></div><table class="table"><thead><tr><th>Name</th><th>Stage</th><th>Status</th><th>Amount</th><th>Probability</th><th>Close</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.OpportunityName</td><td>@x.Stage</td><td>@x.Status</td><td>₹@x.Amount.ToString("N2")</td><td>@x.Probability%</td><td>@x.ExpectedCloseDate.ToShortDateString()</td><td><a asp-action="Edit" asp-route-id="@x.OpportunityId">Edit</a></td></tr>}</tbody></table>
