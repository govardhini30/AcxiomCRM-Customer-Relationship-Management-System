@model DashboardVM
@{ ViewData["Title"] = "Dashboard"; }
<h1>Dashboard</h1><div class="row g-3 mb-4">@foreach(var item in new[]{("Customers",Model.Customers),("Leads",Model.Leads),("Open Leads",Model.OpenLeads),("Opportunities",Model.Opportunities),("Open Opportunities",Model.OpenOpportunities),("Won",Model.Won),("Lost",Model.Lost)}){<div class="col-md-3"><div class="card shadow-sm p-3"><small>@item.Item1</small><h2>@item.Item2</h2></div></div>}<div class="col-md-3"><div class="card shadow-sm p-3"><small>Weighted Pipeline</small><h2>₹@Model.Pipeline.ToString("N2")</h2></div></div></div><div class="row"><div class="col-md-6"><div class="card p-3"><h5>Lead Status</h5><canvas id="leadChart"></canvas></div></div><div class="col-md-6"><div class="card p-3"><h5>Opportunity Pipeline</h5><canvas id="opportunityChart"></canvas></div></div></div><script>new Chart(document.getElementById('leadChart'),{type:'doughnut',data:{labels:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatus.Keys)),datasets:[{data:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatus.Values))}]}});new Chart(document.getElementById('opportunityChart'),{type:'bar',data:{labels:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OpportunityPipeline.Keys)),datasets:[{label:'Amount',data:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OpportunityPipeline.Values))}]},options:{scales:{y:{beginAtZero:true}}}});</script>
