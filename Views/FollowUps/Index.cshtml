@model IEnumerable<FollowUp>
@{ ViewData["Title"] = "Follow-Ups"; }<div class="d-flex justify-content-between"><h2>Follow-Ups</h2><a class="btn btn-primary" asp-action="Create">Schedule</a></div><table class="table"><thead><tr><th>Date</th><th>Type</th><th>Status</th><th>Remarks</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.FollowUpDate.ToShortDateString()</td><td>@x.FollowUpType</td><td>@x.Status</td><td>@x.Remarks</td><td>@if(x.Status=="Planned"){<form asp-action="Complete" method="post" class="d-inline"><input type="hidden" name="id" value="@x.FollowUpId"/><button class="btn btn-sm btn-success">Complete</button></form>}</td></tr>}</tbody></table>
