@model IEnumerable<Customer>
@{ ViewData["Title"] = "Customers"; }<div class="d-flex justify-content-between"><h2>Customers</h2><a class="btn btn-primary" asp-action="Create">Create</a></div><form class="my-3"><input name="q" class="form-control" placeholder="Search name, email, phone, company" value="@Context.Request.Query["q"]" /></form><table class="table table-striped"><thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Company</th><th>Actions</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.CustomerName</td><td>@x.Email</td><td>@x.Phone</td><td>@x.CompanyName</td><td><a asp-action="Edit" asp-route-id="@x.CustomerId">Edit</a></td></tr>}</tbody></table>
