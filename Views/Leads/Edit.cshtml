@model Lead
@{ ViewData["Title"] = "Edit Lead"; }<h2>Edit Lead</h2><form asp-action="Edit" method="post"><input asp-for="LeadId" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><input asp-for="LeadName" class="form-control mb-2"/><input asp-for="Email" class="form-control mb-2"/><input asp-for="Phone" class="form-control mb-2"/><input asp-for="CompanyName" class="form-control mb-2"/><input asp-for="Source" class="form-control mb-2"/><select asp-for="Status" class="form-select mb-2"><option>New</option><option>Contacted</option><option>Qualified</option><option>Unqualified</option><option>Converted</option><option>Lost</option></select><select asp-for="Priority" class="form-select mb-2"><option>Low</option><option>Medium</option><option>High</option></select><input asp-for="ExpectedValue" class="form-control mb-2"/><button class="btn btn-success">Save</button></form>
