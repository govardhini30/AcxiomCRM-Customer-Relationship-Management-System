@model IEnumerable<Lead>
@{ ViewData["Title"] = "Leads"; }<div class="d-flex justify-content-between"><h2>Leads</h2><a class="btn btn-primary" asp-action="Create">Create</a></div><form class="my-3"><input name="q" class="form-control" placeholder="Search lead, company, status" value="@Context.Request.Query["q"]" /></form><table class="table"><thead><tr><th>Name</th><th>Company</th><th>Status</th><th>Priority</th><th>Value</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.LeadName</td><td>@x.CompanyName</td><td>@x.Status</td><td>@x.Priority</td><td>₹@x.ExpectedValue.ToString("N2")</td><td><a asp-action="Edit" asp-route-id="@x.LeadId">Edit</a></td></tr>}</tbody></table>
