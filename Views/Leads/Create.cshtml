@model Lead
@{ ViewData["Title"] = "Create Lead"; }<h2>Create Lead</h2><form asp-action="Create" method="post"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="LeadName" class="form-control mb-2" placeholder="Lead name"/><input asp-for="Email" class="form-control mb-2" placeholder="Email"/><input asp-for="Phone" class="form-control mb-2" placeholder="Phone"/><input asp-for="CompanyName" class="form-control mb-2" placeholder="Company"/><input asp-for="Source" class="form-control mb-2" placeholder="Source"/><select asp-for="Status" class="form-select mb-2"><option>New</option><option>Contacted</option><option>Qualified</option><option>Unqualified</option><option>Converted</option><option>Lost</option></select><select asp-for="Priority" class="form-select mb-2"><option>Low</option><option>Medium</option><option>High</option></select><input asp-for="ExpectedValue" class="form-control mb-2" placeholder="Expected value"/><button class="btn btn-success">Save</button></form>
