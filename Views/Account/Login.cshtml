@model LoginVM
@{ ViewData["Title"] = "Login"; }
<div class="row justify-content-center"><div class="col-md-5"><h2>Login</h2><form asp-action="Login" method="post"><div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="username" /></div><div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="current-password" /></div><div class="form-check mb-3"><input asp-for="RememberMe" class="form-check-input"/><label asp-for="RememberMe" class="form-check-label"></label></div><button class="btn btn-primary">Login</button></form><p class="mt-3"><a asp-action="Register">Create an account</a></p></div></div>
